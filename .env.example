# The booking API (the server's public endpoint, not /graphql)
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:2200/booking/graphql

# Cloudflare Turnstile site key (public). This one is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Where the site is served. "/book" for kisetsuspa.com/book; "" for a subdomain.
NEXT_PUBLIC_BASE_PATH=/book

# "true" runs the site without a backend (in-browser mock; any 6-digit code works)
NEXT_PUBLIC_MOCK_API=false
